{
  "name": "river",
  "version": "1.3.2",
  "description": "Ривер: техасский холдем для своей компании, без серверов",
  "author": "vldvr",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "homepage": "https://github.com/vldvr/river",
  "repository": {
    "type": "git",
    "url": "https://github.com/vldvr/river.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "node tools/check-boundaries.mjs",
    "test": "vitest run",
    "sim": "node --experimental-strip-types tools/sim.ts",
    "pack:win": "npm run build && electron-builder --win --x64 --publish never",
    "release:win": "npm run build && electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "@achingbrain/nat-port-mapper": "4.0.5",
    "electron-updater": "6.8.11",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "fast-check": "4.10.2",
    "motion": "14.7.1",
    "pokersolver": "2.1.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  }
}
